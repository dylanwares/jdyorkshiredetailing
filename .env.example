# Copy to .env for local development. Every variable is optional locally:
# the site falls back to bundled data when they are not set.

# Google Sheet "Prices" tab, published to the web as CSV
PRICES_CSV_URL=

# Behold JSON feed URL (Instagram gallery)
BEHOLD_FEED_URL=
# Optional: only show Instagram posts whose caption contains this hashtag, e.g. #website
GALLERY_HASHTAG=

# Resend (contact form email)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Verified Resend sender on jdyorkshiredetailingcompany.com
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (contact form spam protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
