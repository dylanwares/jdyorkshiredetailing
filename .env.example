# Copy to .env for local development. Every variable is optional locally:
# the site falls back to bundled data when they are not set.

# Google Sheet "Prices" tab, published to the web as CSV
PRICES_CSV_URL=

# Google Drive gallery (server-side only, never expose to the browser)
# API key from Google Cloud with the Drive API enabled
GOOGLE_DRIVE_KEY=
# ID of the shared Drive folder of gallery photos (the last part of the folder URL)
GOOGLE_DRIVE_FOLDER_ID=

# Contact form delivery. Every enquiry goes to every channel that is configured below
# (email and/or Telegram); it counts as delivered if at least one succeeds.

# Email via Resend (resend.com)
#  1. Create an account, then Domains -> add jdyorkshiredetailingcompany.com and add the DNS records it shows.
#  2. API Keys -> create a key with "Sending access".
RESEND_API_KEY=
# Where enquiries are sent (comma-separate several addresses)
CONTACT_TO_EMAIL=
# Verified sender on the domain, e.g. JD Yorkshire Detailing <enquiries@jdyorkshiredetailingcompany.com>
# For first tests before DNS is verified, use onboarding@resend.dev and send to your own Resend login email.
CONTACT_FROM_EMAIL=

# Instant phone alert via a Telegram bot (optional)
#  1. In Telegram, message @BotFather -> /newbot -> copy the token it gives you.
#  2. The client opens the new bot in Telegram and presses Start (or sends it any message).
#  3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy the number at "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile spam protection (OPTIONAL: leave both empty to run on the honeypot and rate limit alone)
# To enable: dash.cloudflare.com -> Turnstile -> add a site for the domain, then set BOTH keys.
# For testing, Cloudflare's dummy keys always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
