---
import type { PriceCategory } from '../lib/prices';

interface Props {
  categories: PriceCategory[];
}

const { categories } = Astro.props;
const fmt = (n: number | null) => (n === null ? 'Contact for quote' : `£${n}`);
// Category names come from the sheet and may contain spaces, which aren't valid in an id.
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<div class="space-y-14">
  {
    categories.map((cat) => (
      <section aria-labelledby={`cat-${slug(cat.category)}`}>
        <h2 id={`cat-${slug(cat.category)}`} class="border-l-4 border-brand pl-4 text-2xl sm:text-3xl">{cat.category}</h2>
        <ul class="mt-6">
          {cat.services.map((s) => (
            <li class="flex flex-col gap-2 border-b border-line py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
              <div>
                <h3 class="text-lg normal-case">{s.service}</h3>
                {s.description && <p class="mt-1 text-sm text-muted">{s.description}</p>}
              </div>
              <p class:list={['shrink-0 font-display font-bold text-brand sm:text-right', s.price === null ? 'text-base' : 'text-2xl']}>
                {fmt(s.price)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p class="text-sm text-muted">Prices are a guide — final quote depends on vehicle condition.</p>
</div>
