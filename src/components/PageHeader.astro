---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-line bg-gradient-to-b from-surface to-ink py-14 md:py-20">
  <div class="container-page">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-muted">{intro}</p>}
  </div>
</section>
