---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PriceTable from '../components/PriceTable.astro';
import CTA from '../components/CTA.astro';
import { getPrices } from '../lib/prices';

// Server-rendered so price changes in the sheet show up without a redeploy.
export const prerender = false;

const categories = await getPrices();
Astro.response.headers.set('Cache-Control', 's-maxage=600, stale-while-revalidate=3600');
---

<BaseLayout title="Prices" description="Mobile car detailing prices in Barnsley and South Yorkshire: valets, machine polishing and ceramic coating.">
  <PageHeader eyebrow="Prices" title="Simple, clear pricing" intro="Our mobile detailing prices, with everything brought to your door. Not sure which service you need? Get in touch for a quote." />
  <div class="container-page py-14"><PriceTable categories={categories} /></div>
  <CTA />
</BaseLayout>
