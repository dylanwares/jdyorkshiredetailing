---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPrices } from '../lib/prices';
import { site } from '../data/site';

// Server-rendered so the service list follows the live price sheet and ?sent=1 can show a confirmation.
export const prerender = false;

const services = (await getPrices()).flatMap((c) => c.services.map((s) => s.service));
const sent = Astro.url.searchParams.get('sent') === '1';
const errorCode = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  invalid: 'Some details were missing or not valid. Please check the form and try again.',
  verify: 'We couldn’t verify you’re human. Please try again.',
  ratelimit: 'You’ve sent a few enquiries already. Please try again later.',
  failed: 'Sorry, we couldn’t send your enquiry.',
};
Astro.response.headers.set('Cache-Control', 's-maxage=600, stale-while-revalidate=3600');
---


<BaseLayout title="Contact & Free Quotes" description="Get a free quote for mobile car detailing in Barnsley and South Yorkshire. Send us an enquiry or give us a call.">
  <PageHeader eyebrow="Contact" title="Get a quote" intro="Tell us about your car and we’ll get back to you." />
  <div class="container-page grid gap-12 py-14 lg:grid-cols-[1fr_20rem]">
    <div>
      {
        sent ? (
          <div class="border border-brand bg-surface p-8" role="status">
            <h2 class="text-2xl">Thanks, we’ve got your enquiry</h2>
            <p class="mt-3 text-muted">We’ll be in touch as soon as we can. If it’s urgent, call us on <a href={site.phoneHref} class="text-brand underline">{site.phone}</a>.</p>
          </div>
        ) : (
          <>
            {errorCode && (
              <p class="mb-6 border border-red-400 p-4 text-sm text-red-400" role="alert">
                {errorMessages[errorCode] ?? errorMessages.failed} You can also call us on <a href={site.phoneHref} class="underline">{site.phone}</a>.
              </p>
            )}
            <ContactForm services={services} />
          </>
        )
      }
    </div>

    <aside class="h-fit border border-line bg-surface p-6">
      <h2 class="text-xl">Contact details</h2>
      <ul class="mt-4 space-y-3 text-slate-300">
        <li><a href={site.phoneHref} class="hover:text-brand">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all hover:text-brand">{site.email}</a></li>
        <li>{site.hours}</li>
        <li>{site.serviceArea}</li>
        <li><a href={site.instagramUrl} target="_blank" rel="noopener" class="hover:text-brand">Instagram @{site.instagramHandle}</a></li>
      </ul>
    </aside>
  </div>
</BaseLayout>
