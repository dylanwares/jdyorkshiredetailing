---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import CTA from '../components/CTA.astro';
import { getGalleryImages } from '../lib/gallery';
import { site } from '../data/site';

// Server-rendered so new photos in the Drive folder show up without a redeploy.
export const prerender = false;

const images = await getGalleryImages();
Astro.response.headers.set('Cache-Control', 's-maxage=1800, stale-while-revalidate=3600');
---

<BaseLayout title="Our Work: Car Detailing Gallery" description="Photos of recent mobile car detailing jobs across Barnsley and South Yorkshire by Jack Daniel’s Yorkshire Detailing Company.">
  <PageHeader eyebrow="Our work" title="Recent results" intro="A look at recent jobs, straight from the driveway. Tap a photo to see it larger." />
  <div class="container-page py-14">
    <GalleryGrid images={images} />
    <div class="mt-10 text-center">
      <a href={site.instagramUrl} target="_blank" rel="noopener" class="btn-primary">Follow us on Instagram</a>
    </div>
  </div>
  <CTA />
  <Lightbox />
</BaseLayout>
