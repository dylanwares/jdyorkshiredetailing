---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const services = [
  { name: 'Valets', text: 'From a quick refresh to a full interior and exterior deep clean.' },
  { name: 'Machine Polish', text: 'Remove swirls and restore deep, reflective gloss.' },
  { name: 'Ceramic Coating', text: 'Long-lasting protection that keeps your car cleaner for longer.' },
];
const reasons = [
  { title: 'We come to you', text: 'Home or work, we bring the water, power and kit.' },
  { title: 'Proper products', text: 'Professional-grade products and safe wash methods.' },
  { title: 'Local & reliable', text: 'Barnsley based, covering South Yorkshire.' },
];
---

<BaseLayout
  title={site.name}
  description="Mobile car detailing in Barnsley and across South Yorkshire. Valets, machine polishing and ceramic coating brought to your door."
>
  <section class="relative isolate flex min-h-[85svh] items-center overflow-hidden">
    <video
      id="hero-video"
      class="absolute inset-0 -z-20 h-full w-full object-cover transition-opacity duration-1000 ease-in-out"
      poster="/videos/hero-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/95 via-ink/75 to-ink/50"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t from-ink to-transparent"></div>
    <div class="container-page py-20">
      <p class="eyebrow">{site.serviceArea}</p>
      <h1 class="mt-4 max-w-3xl text-5xl leading-[0.95] sm:text-7xl">Showroom shine, <span class="text-brand">at your door</span></h1>
      <p class="mt-6 max-w-xl text-lg text-slate-200">Professional mobile car detailing. Tell us where you are and we’ll bring everything needed to make your car look its best.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary">Get a quote</a>
        <a href={site.phoneHref} class="btn-outline">Call {site.phone}</a>
      </div>
    </div>
  </section>

  <section class="container-page py-16 md:py-24">
    <p class="eyebrow">Recent work</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl sm:text-4xl">Our work</h2>
      <a href="/our-work" class="btn-outline">View gallery</a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3">
      {Array.from({ length: 6 }, (_, i) => <Placeholder label={`Gallery photo ${i + 1}`} class="aspect-square" />)}
    </div>
  </section>

  <section class="border-y border-line bg-surface py-16 md:py-24">
    <div class="container-page">
      <p class="eyebrow">Services</p>
      <h2 class="mt-3 text-3xl sm:text-4xl">What we do</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          services.map((s) => (
            <a href="/prices" class="group block border border-line bg-ink transition-colors hover:border-brand">
              <Placeholder label={`${s.name} photo`} class="aspect-[4/3]" />
              <div class="p-5">
                <h3 class="text-xl group-hover:text-brand">{s.name}</h3>
                <p class="mt-2 text-sm text-muted">{s.text}</p>
                <span class="mt-4 inline-block font-display text-xs font-bold uppercase tracking-widest text-brand">See prices →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-16 md:py-24">
    <p class="eyebrow">Why choose us</p>
    <h2 class="mt-3 text-3xl sm:text-4xl">Detailing done properly</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {reasons.map((r) => (
        <div class="border-t-2 border-brand pt-4">
          <h3 class="text-xl">{r.title}</h3>
          <p class="mt-2 text-muted">{r.text}</p>
        </div>
      ))}
    </div>

    <h3 class="mt-16 text-2xl">What customers say</h3>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {Array.from({ length: 3 }, () => (
        <figure class="border border-line bg-surface p-6">
          <p class="text-brand" aria-label="5 out of 5 stars">★★★★★</p>
          <blockquote class="mt-3 text-muted">Customer review placeholder — real reviews coming soon.</blockquote>
          <figcaption class="mt-4 text-sm font-semibold">Customer name</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CTA />
</BaseLayout>

<script>
  // Hero background: cycles through the clips in public/videos (hero-N.mp4 / hero-N-mobile.mp4),
  // fading out at the end of each clip and in on the next. Only the first clip loads up front;
  // each following clip is fetched while the current one plays. Reduced-motion visitors keep the
  // poster image; slow or data-saver connections get the first clip on a plain loop.
  const CLIP_COUNT = 4;
  const FADE_SECONDS = 1;

  const video = document.querySelector<HTMLVideoElement>('#hero-video');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (video && !reduceMotion) {
    const suffix = matchMedia('(max-width: 767px)').matches ? '-mobile' : '';
    const clipUrl = (i: number) => `/videos/hero-${i + 1}${suffix}.mp4`;
    const connection = (navigator as any).connection;
    const lightweight = connection?.saveData || /(^|-)(2g|3g)$/.test(connection?.effectiveType ?? '');

    let current = 0;
    let nextBlobUrl: string | null = null;
    let currentBlobUrl: string | null = null;
    let fadingOut = false;

    video.loop = lightweight;
    video.src = clipUrl(0);
    video.play().catch(() => {});

    if (!lightweight) {
      const preloadNext = () => {
        const next = (current + 1) % CLIP_COUNT;
        fetch(clipUrl(next))
          .then((r) => (r.ok ? r.blob() : Promise.reject()))
          .then((blob) => {
            nextBlobUrl = URL.createObjectURL(blob);
          })
          .catch(() => {});
      };
      video.addEventListener('playing', () => {
        video.style.opacity = '1';
        if (!nextBlobUrl && !fadingOut) preloadNext();
      });

      video.addEventListener('timeupdate', () => {
        if (!fadingOut && video.duration && video.currentTime >= video.duration - FADE_SECONDS) {
          fadingOut = true;
          video.style.opacity = '0';
        }
      });

      video.addEventListener('ended', () => {
        current = (current + 1) % CLIP_COUNT;
        if (currentBlobUrl) URL.revokeObjectURL(currentBlobUrl);
        currentBlobUrl = nextBlobUrl;
        nextBlobUrl = null;
        fadingOut = false;
        video.src = currentBlobUrl ?? clipUrl(current);
        video.play().catch(() => {});
      });
    }
  }
</script>
