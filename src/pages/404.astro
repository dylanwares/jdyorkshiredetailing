---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found." noindex>
  <section class="container-page flex min-h-[60svh] flex-col items-start justify-center py-20">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-5xl sm:text-7xl">Off the road</h1>
    <p class="mt-4 max-w-md text-lg text-muted">We couldn’t find that page. Let’s get you back on track.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</BaseLayout>
